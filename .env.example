PORT=3000
# development | production
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/postgres
JWT_PRIVATE_KEY=replace-me-base64-pem
JWT_PUBLIC_KEY=replace-me-base64-pem

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
REDIRECT_URI=http://localhost:3000/oauth/callback
EXPO_SCHEME=replace-me

COGNITO_REGION=replace-me
COGNITO_USER_POOL_ID=replace-me
COGNITO_USER_POOL_CLIENT_ID=replace-me

# Comma-separated emails that get dev bypass (optional)
BYPASS_EMAILS=
# Dev-only claim mocking (optional)
MOCK_ENABLED=false

# Used by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=postgres
